AuthController --> AccountService : uses
AccountController --> AccountService : uses
AccountController --> AuthService : uses
TransactionController --> TransactionRepository : uses
TransactionController --> AuthService : uses
MetricsController --> CityController : uses
MetricsController --> AuditLogRepository : uses
MetricsController --> AuthService : uses

PaymentService --> NotificationSubject : uses
PaymentService --> PaymentSecurityCheck : uses
PaymentService --> CryptoPaymentAdapter : uses via factory
PaymentService --> CityController : uses
PaymentService --> FraudRiskAnalysisService : uses
PaymentService --> AuditService : uses
PaymentService --> AccountRepository : uses
PaymentService --> TransactionRepository : uses

AuthService --> UserRepository : uses
AuthService --> JwtService : uses
AuthService --> PasswordEncoder : uses

AccountService --> AccountRepository : uses

FraudRiskAnalysisService --> TransactionRepository : uses

AuditService --> AuditLogRepository : uses

PaymentCommand --> PaymentService : uses
FiatPaymentCommand --> PaymentService
CryptoPaymentCommand --> PaymentService

